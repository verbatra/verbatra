{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "cacheDir": ".turbo/cache",
  "globalPassThroughEnv": ["BASE_SHA", "HEAD_BRANCH", "HEAD_SHA", "PUBLISHED_PACKAGES_JSON"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
