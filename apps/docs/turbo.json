{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "generate", "typecheck"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "lib/version.generated.json",
        "app/brand-colors.generated.css",
        "lib/translation-freshness.generated.json"
      ]
    },
    "generate": {
      "inputs": ["content/**", "source.config.ts", "package.json"],
      "outputs": [".source/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "typecheck", "build"],
      "outputs": []
    }
  }
}
