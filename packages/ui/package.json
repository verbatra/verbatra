{
  "name": "@verbatra/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared design tokens for the verbatra docs site and Studio dashboard.",
  "license": "MIT",
  "author": "Mario Kreitz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/verbatra/verbatra.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens.css": "./src/tokens.css"
  },
  "engines": {
    "node": "^22.18.0 || >=24"
  },
  "scripts": {
    "lint": "biome check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@verbatra/config": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
