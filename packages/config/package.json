{
  "name": "@verbatra/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared build, TypeScript and lint configuration for the verbatra monorepo",
  "license": "MIT",
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./tsconfig.package.json": "./tsconfig.package.json",
    "./tsdown": {
      "types": "./tsdown.base.d.mts",
      "default": "./tsdown.base.mjs"
    },
    "./vitest": {
      "types": "./vitest.base.d.mts",
      "default": "./vitest.base.mjs"
    },
    "./scaling": {
      "types": "./scaling.base.d.mts",
      "default": "./scaling.base.mjs"
    }
  },
  "files": [
    "tsconfig.base.json",
    "tsconfig.package.json",
    "biome.json",
    "tsdown.base.mjs",
    "tsdown.base.d.mts",
    "vitest.base.mjs",
    "vitest.base.d.mts",
    "scaling.base.mjs",
    "scaling.base.d.mts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
