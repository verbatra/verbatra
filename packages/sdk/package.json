{
  "name": "@verbatra/sdk",
  "version": "0.11.1",
  "type": "module",
  "description": "Programmatic API to automate i18n translation and keep your locale files in sync across languages, using OpenAI, Anthropic, Gemini, DeepL, or an openai-compatible local or self-hosted model.",
  "keywords": [
    "i18n",
    "internationalization",
    "localization",
    "l10n",
    "translation",
    "locale",
    "ai",
    "machine-translation",
    "deepl",
    "openai",
    "anthropic",
    "gemini",
    "openai-compatible",
    "local-llm",
    "ollama",
    "i18next",
    "vue-i18n",
    "next-intl",
    "ngx-translate",
    "xliff",
    "yaml",
    "arb",
    "flutter",
    "java-properties",
    "sdk",
    "automation"
  ],
  "license": "MIT",
  "author": "Mario Kreitz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/verbatra/verbatra.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://verbatra.kreitz-webdev.de",
  "bugs": {
    "url": "https://github.com/verbatra/verbatra/issues"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./config-schema.json": "./dist/config-schema.json",
    "./schemas/*": "./dist/schemas/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.18.0 || >=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && node scripts/emit-schemas.mjs",
    "lint": "biome check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "catalog:bundled",
    "@formatjs/icu-messageformat-parser": "catalog:bundled",
    "@google/genai": "catalog:bundled",
    "@xmldom/xmldom": "catalog:bundled",
    "chokidar": "catalog:",
    "cosmiconfig": "10.0.1",
    "cosmiconfig-typescript-loader": "6.3.0",
    "deepl-node": "catalog:bundled",
    "exceljs": "catalog:bundled",
    "jszip": "catalog:bundled",
    "loglevel": "catalog:bundled",
    "openai": "catalog:bundled",
    "yaml": "catalog:bundled",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@verbatra/ai-providers": "workspace:*",
    "@verbatra/config": "workspace:*",
    "@verbatra/core": "workspace:*",
    "@verbatra/exchange": "workspace:*",
    "@verbatra/extract": "workspace:*",
    "@verbatra/format-adapters": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
