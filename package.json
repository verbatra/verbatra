{
  "name": "verbatra-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "i18n translation automation tool (monorepo root)",
  "license": "MIT",
  "author": "Mario Kreitz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/verbatra/verbatra.git"
  },
  "homepage": "https://verbatra.kreitz-webdev.de",
  "bugs": {
    "url": "https://github.com/verbatra/verbatra/issues"
  },
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=11.6.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "biome format --write .",
    "check": "biome check .",
    "verify": "pnpm check:no-em-dash && pnpm check && pnpm build && pnpm check:dts && pnpm check:studio-bundle && pnpm check:config-schema && pnpm turbo run typecheck && pnpm typecheck:configs && pnpm test && pnpm test:scripts",
    "check:no-em-dash": "! git grep -n -- \"$(printf '\\342\\200\\224')\" -- ':!pnpm-lock.yaml'",
    "check:dts": "node scripts/check-build-output.mjs dts",
    "check:studio-bundle": "node scripts/check-build-output.mjs studio-bundle",
    "check:config-schema": "node scripts/check-build-output.mjs config-schema",
    "check:dependency-changeset": "node scripts/check-dependency-changeset.mjs",
    "knip": "knip",
    "test:scripts": "vitest run --dir scripts",
    "typecheck:configs": "tsc -p tsconfig.configs.json",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@commitlint/types": "21.2.0",
    "@vitest/coverage-v8": "catalog:",
    "knip": "catalog:",
    "lefthook": "2.1.10",
    "turbo": "2.10.11",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
